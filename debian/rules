#!/usr/bin/make -f
# Makefile used by dpkg-buildpackage

# dh-virtualenv options
# https://dh-virtualenv.readthedocs.io/en/1.1/usage.html
DH_VIRTUALENV_ARGS = \
	--requirements='requirements.prod.txt' \
	--python='/usr/bin/python3' \
	--builtin-venv \
	--preinstall=wheel \
	--extra-pip-arg='--progress-bar=off' \
	--extra-pip-arg='--log=/dev/stdout' \
	--extra-pip-arg='--quiet'

# Staged virtualenv for the portal package (before .deb install)
VENV_DIR = $(CURDIR)/debian/portal/opt/venvs/portal


override_dh_virtualenv:
	# lines preceding `dh_virtualenv` occur before venv creation and pip install

	# Build front-end files
	bin/build-frontend-files.sh

	# Build front-end translations (JSON) from gettext files (PO)
	bin/build-frontend-translations.sh

	dh_virtualenv $(DH_VIRTUALENV_ARGS)

	# Compile backend PO files to MO files via the staged venv.
	# Call create_app/compile_pos directly so ImportErrors surface as
	# real tracebacks (Flask 1.0 CLI swallows NoAppException as
	# "No such command").
	# Run from / so the source checkout is not auto-discovered.
	cd / && \
	LANG=C.UTF-8 \
	SECRET_KEY=build-only \
		$(VENV_DIR)/bin/python -c \
		"from portal.factories.app import create_app; \
		from portal.models.i18n_utils import compile_pos; \
		app = create_app(); \
		ctx = app.app_context(); ctx.push(); \
		compile_pos(); \
		print('Compiled backend PO files to MO files')"

override_dh_strip:
	# Binary wheels in the venv can break under dh_strip; see
	# https://dh-virtualenv.readthedocs.io/en/latest/howtos.html
	dh_strip --exclude=/site-packages/

override_dh_builddeb:
	dh_builddeb

%:
	dh $@ --with python-virtualenv
